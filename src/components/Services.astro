---
import PillCta from './PillCta.astro';

const services = [
	{ title: 'Web development', icon: 'web' },
	{ title: 'App development', icon: 'app' },
	{ title: 'Product UI', icon: 'ui' },
	{ title: 'Performance', icon: 'perf' },
];
const homeHref = new URL('', `https://example.com${import.meta.env.BASE_URL}`).pathname;
const contactHref = `${homeHref}#contact`;
---

<section class="py-4 pb-12" id="services">
	<div class="container-page">
		<div
			class="animate-fade-up-delay-2 motion-reduce:animate-none grid items-center gap-8 rounded-4xl bg-mint px-6 py-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10 lg:p-11"
		>
			<div>
				<h2 class="mb-4 max-w-[16ch] font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
					What I build.
				</h2>
				<p class="mb-7 max-w-[34ch] text-muted">
					From marketing sites to App Store releases — focused delivery, clean interfaces, and code you
					can keep shipping on.
				</p>
				<PillCta href={contactHref}>Start a project</PillCta>
			</div>

			<ul class="m-0 grid list-none grid-cols-2 gap-3.5 p-0 lg:gap-4">
				{
					services.map((service) => (
						<li class="flex min-h-38 flex-col justify-between gap-6 rounded-3xl bg-white p-5 shadow-[0_4px_20px_rgba(10,10,10,0.03)] lg:min-h-44 lg:p-6">
							<span class="grid size-11 place-items-center rounded-full bg-lemon text-ink" aria-hidden="true">
								{service.icon === 'web' && (
									<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
										<circle cx="12" cy="12" r="9" />
										<path d="M3 12h18M12 3c2.5 2.8 2.5 15.2 0 18M12 3c-2.5 2.8-2.5 15.2 0 18" />
									</svg>
								)}
								{service.icon === 'app' && (
									<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
										<rect x="7" y="3" width="10" height="18" rx="2" />
										<path d="M11 18h2" stroke-linecap="round" />
									</svg>
								)}
								{service.icon === 'ui' && (
									<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
										<rect x="3" y="4" width="18" height="16" rx="2" />
										<path d="M3 9h18M9 9v11" />
									</svg>
								)}
								{service.icon === 'perf' && (
									<svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
										<path d="M4 16l5-5 4 4 7-8" stroke-linecap="round" stroke-linejoin="round" />
										<path d="M14 7h6v6" stroke-linecap="round" stroke-linejoin="round" />
									</svg>
								)}
							</span>
							<span class="font-display text-[1.05rem] font-semibold tracking-tight">{service.title}</span>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
