---
interface Props {
	/** `a` is trusted HTML written in the page source (never user input). */
	faqs: { q: string; a: string }[];
}

const { faqs } = Astro.props;
---

<div class="divide-y divide-ink/8 border-y border-ink/8">
	{
		faqs.map((faq) => (
			<details class="group py-4">
				<summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display font-semibold tracking-tight [&::-webkit-details-marker]:hidden">
					{faq.q}
					<span class="grid size-7 shrink-0 place-items-center rounded-full bg-lemon transition group-open:rotate-45" aria-hidden="true">
						<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
							<path d="M12 5v14M5 12h14" stroke-linecap="round" />
						</svg>
					</span>
				</summary>
				<p class="mt-3 text-muted [&_strong]:text-ink" set:html={faq.a} />
			</details>
		))
	}
</div>
