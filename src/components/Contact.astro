---
import PillCta from './PillCta.astro';
---

<section class="py-8 pb-4" id="contact">
	<div
		class="container-page grid gap-6 border-t border-ink/6 py-10 md:grid-cols-[1fr_auto] md:items-end md:gap-8"
	>
		<div>
			<h2 class="mb-3.5 max-w-[16ch] font-display text-[clamp(1.85rem,3.5vw,2.5rem)] leading-tight font-bold tracking-tight">
				Let’s build something solid.
			</h2>
			<p class="max-w-[40ch] text-muted">
				Have a site, app, or product idea? Send a note — I’ll get back with next steps and timing.
			</p>
		</div>
		<PillCta href="mailto:hello@lukeacoleman.dev">hello@lukeacoleman.dev</PillCta>
	</div>
</section>
