---
import { Image } from 'astro:assets';
import AppStoreBadge from './AppStoreBadge.astro';
import { apps } from '../data/apps';

const base = import.meta.env.BASE_URL;
const joinBase = (path = '') => new URL(path, `https://example.com${base}`).pathname;
---

<section class="py-4 pb-12" id="apps" aria-labelledby="apps-heading">
	<div class="container-page">
		<h2 id="apps-heading" class="mb-3 font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
			Apps I’ve made.
		</h2>
		<p class="mb-7 max-w-[44ch] text-muted">Designed, built and shipped by me, with more on the way.</p>

		{/* Grows as apps are added: 1 column on phones, 2 on tablets, 3 on desktop */}
		<ul class="m-0 grid list-none gap-3.5 p-0 sm:grid-cols-2 lg:grid-cols-3 lg:gap-4">
			{
				apps.map((app) => (
					<li class="flex flex-col rounded-3xl border border-ink/8 bg-white p-6 shadow-[0_4px_20px_rgba(10,10,10,0.03)]">
						<Image src={app.icon} alt="" width={64} height={64} densities={[1, 2]} class="mb-5 size-16 rounded-[22%]" />
						<h3 class="font-display text-[1.2rem] font-semibold tracking-tight">{app.name}</h3>
						<p class="mb-2 text-[0.9rem] font-medium text-ink/70">{app.tagline}</p>
						<p class="mb-6 text-muted">{app.summary}</p>

						{/* mt-auto pins the buttons to the bottom so cards line up when text lengths differ */}
						<div class="mt-auto flex flex-wrap items-center gap-x-5 gap-y-3">
							<AppStoreBadge href={app.appStoreUrl} appName={app.name} size="sm" />
							<a
								href={joinBase(app.slug)}
								class="font-display text-[0.95rem] font-semibold underline decoration-2 underline-offset-[0.45em]"
								aria-label={`Learn more about ${app.name}`}
							>
								Learn more
							</a>
						</div>
					</li>
				))
			}
		</ul>
	</div>
</section>
