---
import { Image } from 'astro:assets';
import { apps as allApps } from '../data/apps';

const base = import.meta.env.BASE_URL;
const joinBase = (path = '') => new URL(path, `https://example.com${base}`).pathname;
const pathname = Astro.url.pathname;
const relativePath = pathname.startsWith(base) ? pathname.slice(base.length - 1) : pathname;
const homeHref = joinBase();
const servicesHref = `${joinBase()}#services`;
const privacyHref = joinBase('privacy');
const contactHref = `${joinBase()}#contact`;
const isHome = relativePath === '/' || relativePath === '';

// The dropdown lists every app in src/data/apps.ts.
const apps = allApps.map((app) => ({
	...app,
	href: joinBase(app.slug),
	isCurrent: relativePath.startsWith(`/${app.slug}`),
}));
const isApps = apps.some((app) => app.isCurrent);
const isPrivacy = relativePath.startsWith('/privacy');
---

<header class="sticky top-0 z-50 border-b border-ink/4 bg-white/85 backdrop-blur-md">
	<div class="container-page flex min-h-18 items-center justify-between gap-4">
		<a href={homeHref} class="font-display text-[1.05rem] font-bold tracking-tight" aria-label="Luke Coleman home">
			Luke A Coleman
		</a>

		<nav class="hidden items-center gap-7 text-[0.95rem] font-medium text-muted md:flex" aria-label="Primary">
			<a href={homeHref} class:list={['hover:text-ink', { 'text-ink underline decoration-2 underline-offset-[0.45em]': isHome }]}>
				Home
			</a>
			<a href={servicesHref} class="hover:text-ink">Services</a>
			<details class="group relative" data-apps-menu>
				<summary
					class:list={[
						'flex cursor-pointer list-none items-center gap-1.5 hover:text-ink [&::-webkit-details-marker]:hidden',
						{ 'text-ink underline decoration-2 underline-offset-[0.45em]': isApps },
					]}
				>
					Apps
					<svg class="size-3.5 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
						<path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
					</svg>
				</summary>

				<ul class="absolute top-full left-1/2 m-0 mt-4 grid w-72 -translate-x-1/2 list-none gap-1 rounded-3xl border border-ink/6 bg-white p-2 shadow-(--shadow-soft)">
					{
						apps.map((app) => (
							<li>
								<a
									href={app.href}
									aria-current={app.isCurrent ? 'page' : undefined}
									class:list={['flex items-center gap-3 rounded-2xl p-2.5 hover:bg-mint', { 'bg-mint': app.isCurrent }]}
								>
									<Image src={app.icon} alt="" width={40} height={40} densities={[1, 2]} class="size-10 rounded-[22%]" />
									<span>
										<span class="flex items-center gap-2 font-display font-semibold text-ink">
											{app.name}
											{!app.appStoreUrl && (
												<span class="rounded-full bg-lemon px-2 py-0.5 text-[0.7rem] font-semibold tracking-wide uppercase">Soon</span>
											)}
										</span>
										<span class="block text-[0.85rem] leading-snug">{app.tagline}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
			</details>
			<a
				href={privacyHref}
				class:list={['hover:text-ink', { 'text-ink underline decoration-2 underline-offset-[0.45em]': isPrivacy }]}
			>
				Privacy
			</a>
		</nav>

		<a
			href={contactHref}
			class="inline-flex items-center gap-2.5 rounded-full border border-transparent bg-lemon py-1 pr-1 pl-3.5 font-display text-sm font-semibold"
			aria-label="Get in touch"
		>
			<span class="hidden md:inline">Contact</span>
			<span class="grid size-8.5 place-items-center rounded-full bg-ink text-white" aria-hidden="true">
				<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</span>
		</a>
	</div>
</header>

<script>
	// <details> already opens and closes on click, Enter and Space.
	// This adds what people expect from a dropdown menu on top of that.
	const menu = document.querySelector<HTMLDetailsElement>('[data-apps-menu]');

	if (menu) {
		const close = () => menu.removeAttribute('open');

		// Clicking anywhere outside the menu closes it.
		document.addEventListener('click', (event) => {
			if (!menu.contains(event.target as Node)) close();
		});

		// Escape closes it and puts focus back on the "Apps" button.
		menu.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menu.open) {
				close();
				menu.querySelector('summary')?.focus();
			}
		});

		// Tabbing past the last item closes it too.
		menu.addEventListener('focusout', (event) => {
			if (!menu.contains(event.relatedTarget as Node | null)) close();
		});
	}
</script>
