---
const base = import.meta.env.BASE_URL;
const joinBase = (path = '') => new URL(path, `https://example.com${base}`).pathname;
const pathname = Astro.url.pathname;
const relativePath = pathname.startsWith(base) ? pathname.slice(base.length - 1) : pathname;
const homeHref = joinBase();
const servicesHref = `${joinBase()}#services`;
const privacyHref = joinBase('privacy');
const contactHref = `${joinBase()}#contact`;
const isHome = relativePath === '/' || relativePath === '';
const isPrivacy = relativePath.startsWith('/privacy');
---

<header class="sticky top-0 z-50 border-b border-ink/4 bg-white/85 backdrop-blur-md">
	<div class="container-page flex min-h-18 items-center justify-between gap-4">
		<a href={homeHref} class="font-display text-[1.05rem] font-bold tracking-tight" aria-label="Luke Coleman home">
			Luke A Coleman
		</a>

		<nav class="hidden items-center gap-7 text-[0.95rem] font-medium text-muted md:flex" aria-label="Primary">
			<a href={homeHref} class:list={['hover:text-ink', { 'text-ink underline decoration-2 underline-offset-[0.45em]': isHome }]}>
				Home
			</a>
			<a href={servicesHref} class="hover:text-ink">Services</a>
			<a
				href={privacyHref}
				class:list={['hover:text-ink', { 'text-ink underline decoration-2 underline-offset-[0.45em]': isPrivacy }]}
			>
				Privacy
			</a>
		</nav>

		<a
			href={contactHref}
			class="inline-flex items-center gap-2.5 rounded-full border border-transparent bg-lemon py-1 pr-1 pl-3.5 font-display text-sm font-semibold"
			aria-label="Get in touch"
		>
			<span class="hidden md:inline">Contact</span>
			<span class="grid size-8.5 place-items-center rounded-full bg-ink text-white" aria-hidden="true">
				<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
					<path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</span>
		</a>
	</div>
</header>
