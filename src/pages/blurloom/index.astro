---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PillCta from '../../components/PillCta.astro';
import FaqList from '../../components/FaqList.astro';
import AppStoreBadge from '../../components/AppStoreBadge.astro';
import { getApp } from '../../data/apps';

// Blurloom isn't released yet, so this has no appStoreUrl and the badge
// shows "Coming soon". Add the link in src/data/apps.ts at launch.
const { icon, appStoreUrl } = getApp('blurloom');

const supportEmail = 'lukecoleman123@gmail.com';
const supportHref = `mailto:${supportEmail}?subject=${encodeURIComponent('Blurloom support')}`;
const notifyHref = `mailto:${supportEmail}?subject=${encodeURIComponent('Tell me when Blurloom launches')}`;
const privacyHref = new URL('privacy', `https://example.com${import.meta.env.BASE_URL}`).pathname;

// The hero gradient and the CSS snippet use the same values, which is the
// whole point of the app: what you see is exactly what you copy.
const gradient = 'linear-gradient(135deg, #FF8A65, #E8588A, #7B6CF6)';

const features = [
	{
		title: 'Blur any photo',
		body: 'Drag in a photo, slide the blur until it’s calm, and set it as your wallpaper. Your busy holiday snap becomes a soft wash of colour.',
		bg: 'bg-loom-butter',
	},
	{
		title: 'Make a gradient',
		body: 'Pick a few colours and an angle with a live preview. No canvas, no layers, no exporting at the right size.',
		bg: 'bg-loom-peach',
	},
	{
		title: 'Sharp on every screen',
		body: 'Each wallpaper is rendered at the exact resolution of every connected display, from a MacBook to a 5K monitor.',
		bg: 'bg-loom-pink',
	},
	{
		title: 'Copy it as code',
		body: 'Like the gradient? Copy it as CSS or Tailwind and use the same colours in your next build.',
		bg: 'bg-loom-violet text-white',
	},
];

const plans = [
	{
		name: 'Free',
		price: '£0',
		items: ['Blur any photo into a wallpaper', '2-colour gradients and Surprise Me', 'Set as Wallpaper on every display', 'Copy gradients as CSS or Tailwind'],
		highlight: false,
	},
	{
		name: 'Blurloom Pro',
		price: '£2.99 once. No subscription',
		items: ['Effects: colour blend, hue, saturation, vignette and grain', 'Gradients with 3–5 colours', 'Dim in Dark Mode', 'Save Image and Saved Gradients'],
		highlight: true,
	},
];

// Support answers. This page is also the app's App Store "Support URL".
const faqs = [
	{
		q: 'How do I restore Blurloom Pro?',
		a: 'Open the <strong>Blurloom</strong> menu and choose <strong>Restore Purchases</strong>, or click <strong>Restore Purchases</strong> in the Pro unlock sheet. Make sure you’re signed in to the Mac App Store with the Apple Account you bought it with. Pro is a one-off purchase, so restoring never charges you again.',
	},
	{
		q: 'Why did my wallpaper only change on one Space?',
		a: 'macOS only lets apps set the wallpaper for the Space you’re on. With Pro, choose <strong>Save Image…</strong>, then pick the saved image in <strong>System Settings → Wallpaper</strong> and turn on <strong>Show on all Spaces</strong>. On the free version, switch to each Space and click <strong>Set as Wallpaper</strong> again.',
	},
	{
		q: 'Can I try Pro features before buying?',
		a: 'Yes. Effects and extra colours work in the live preview for free. You’ll only be asked to unlock Pro when you set a wallpaper that uses them.',
	},
	{
		q: 'Are my photos uploaded anywhere?',
		a: 'No. Everything happens on your Mac. Blurloom doesn’t connect to the internet itself, and your photos never leave your Mac.',
	},
	{
		q: 'Do I need an account?',
		a: 'No. There’s no sign-up, no ads and no tracking.',
	},
	{
		q: 'How do I copy a gradient as code?',
		a: 'On the <strong>Gradient</strong> tab, click <strong>Copy CSS</strong> or <strong>Copy Tailwind</strong>. The code matches the preview exactly, so you can paste it straight into your project.',
	},
];
---

<BaseLayout
	title="Blurloom — Luke Coleman"
	description="Blurloom turns any photo or a few colours into a calm Mac wallpaper in seconds, and copies the gradient as CSS. Coming soon to the Mac App Store. Support, FAQs and contact."
>
	<!-- Hero -->
	<section class="py-8 pb-12 lg:py-12 lg:pb-16">
		<div class="container-page grid grid-cols-1 items-center gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:gap-12">
			<div class="animate-fade-up motion-reduce:animate-none">
				<Image
					src={icon}
					alt="Blurloom app icon"
					width={96}
					height={96}
					densities={[1, 2]}
					class="mb-6 size-20 rounded-[22%] shadow-(--shadow-soft) lg:size-24"
					loading="eager"
				/>
				<p class="mb-3.5 flex flex-wrap items-center gap-3 text-[0.9rem] font-semibold tracking-[0.06em] text-muted uppercase">
					Mac app
					<span class="rounded-full bg-lemon px-3 py-1 text-[0.75rem] text-ink">Coming soon</span>
				</p>
				<h1 class="mb-4 max-w-[16ch] font-display text-[clamp(2.35rem,5vw,3.6rem)] leading-tight font-bold tracking-tight">
					A calm desktop in about ten seconds.
				</h1>
				<p class="mb-7 max-w-[40ch] text-[1.05rem] text-muted">
					Blurloom turns any photo or a few colours into a calm wallpaper, and hands you the gradient as CSS.
					No Photoshop required.
				</p>
				<div class="flex flex-wrap items-center gap-4">
					<AppStoreBadge href={appStoreUrl} />
					<a href={notifyHref} class="font-display text-[0.95rem] font-semibold underline decoration-2 underline-offset-[0.45em] hover:text-loom-violet">
						Tell me when it launches
					</a>
				</div>
			</div>

			<!-- A real CSS gradient, with the code that makes it underneath -->
			<figure class="animate-fade-up-delay motion-reduce:animate-none">
				<div class="aspect-16/10 rounded-4xl shadow-(--shadow-soft)" style={`background: ${gradient}`} aria-hidden="true"></div>
				<figcaption class="mt-4 overflow-x-auto rounded-2xl bg-ink px-4 py-3 font-mono text-[0.85rem] whitespace-nowrap text-white">
					<span class="text-white/50">background:</span>
					{gradient};
				</figcaption>
			</figure>
		</div>
	</section>

	<!-- Features -->
	<section class="py-4 pb-12" aria-labelledby="features-heading">
		<div class="container-page">
			<h2 id="features-heading" class="mb-6 font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
				Busy photo in, calm desktop out.
			</h2>
			<ul class="m-0 grid list-none gap-3.5 p-0 sm:grid-cols-2 lg:gap-4">
				{
					features.map((feature) => (
						<li class:list={['rounded-3xl p-6 lg:p-7', feature.bg]}>
							<h3 class="mb-2 font-display text-[1.15rem] font-semibold tracking-tight">{feature.title}</h3>
							<p class="opacity-80">{feature.body}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<!-- Privacy -->
	<section class="py-4 pb-12" aria-labelledby="privacy-heading">
		<div class="container-page">
			<div class="grid gap-6 rounded-4xl bg-loom-paper px-6 py-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-10 lg:p-11">
				<h2 id="privacy-heading" class="max-w-[14ch] font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
					Your photos stay on your Mac.
				</h2>
				<ul class="m-0 grid list-none gap-3 p-0 text-ink/80">
					<li>Everything is processed on your Mac. Nothing is uploaded.</li>
					<li>No account, no ads and no tracking.</li>
					<li>
						Read the full <a href={privacyHref} class="font-semibold text-ink underline underline-offset-4">privacy policy</a>.
					</li>
				</ul>
			</div>
		</div>
	</section>

	<!-- Pricing -->
	<section class="py-4 pb-12" aria-labelledby="pricing-heading">
		<div class="container-page">
			<h2 id="pricing-heading" class="mb-2 font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
				Free and Pro.
			</h2>
			<p class="mb-6 max-w-[52ch] text-muted">
				Blurloom is free to download. Pro is one purchase, yours forever. UK price shown; the App Store shows your
				local price.
			</p>
			<div class="grid gap-3.5 md:grid-cols-2 lg:gap-4">
				{
					plans.map((plan) => (
						<div class:list={['rounded-3xl p-6 lg:p-7', plan.highlight ? 'bg-lemon' : 'border border-ink/8 bg-white']}>
							<h3 class="font-display text-[1.15rem] font-semibold tracking-tight">{plan.name}</h3>
							<p class="mb-4 text-[0.95rem] text-ink/70">{plan.price}</p>
							<ul class="m-0 grid list-none gap-2 p-0">
								{plan.items.map((item) => (
									<li class="flex gap-2.5">
										<svg class="mt-1.5 size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true">
											<path d="M5 12.5l4.5 4.5L19 7.5" stroke-linecap="round" stroke-linejoin="round" />
										</svg>
										<span>{item}</span>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Support (target for the App Store "Support URL") -->
	<section id="support" class="scroll-mt-24 py-4" aria-labelledby="support-heading">
		<div class="container-page grid gap-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-12">
			<div>
				<h2 id="support-heading" class="mb-3 font-display text-[clamp(1.85rem,3.5vw,2.6rem)] leading-tight font-bold tracking-tight">
					Support.
				</h2>
				<p class="mb-6 max-w-[36ch] text-muted">
					Stuck, found a bug or have an idea? Email me and I’ll get back to you as soon as I can.
				</p>
				<PillCta href={supportHref}>Email support</PillCta>
				<p class="mt-4 text-[0.9rem] text-muted">{supportEmail}</p>
			</div>

			<FaqList faqs={faqs} />
		</div>
	</section>
</BaseLayout>
